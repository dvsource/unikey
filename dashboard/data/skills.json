 "tags": {
  "wrong-law": {
   "meaning": "Chose a principle that doesn't fit",
   "message": "This law doesn't link what's given to what's asked."
  },
  "wrong-conservation-law": {
   "meaning": "Conserved the wrong quantity",
   "message": "Check which quantity is conserved here."
  },
  "suvat-nonuniform": {
   "meaning": "Used equations of motion with non-constant a",
   "message": "suvat needs constant acceleration."
  },
  "unknown-not-eliminated": {
   "meaning": "Chose an equation that keeps an unknown",
   "message": "Choose an equation that removes the unknown force."
  },
  "assumed-symmetry": {
   "meaning": "Split equally or assumed symmetry that isn't there",
   "message": "Don't assume an equal share. Calculate it."
  },
  "misread-interval": {
   "meaning": "Used the wrong time or distance interval",
   "message": "Which interval does the question give?"
  },
  "no-resolve": {
   "meaning": "Didn't resolve into components",
   "message": "Resolve into components first."
  },
  "sign": {
   "meaning": "Sign or direction error",
   "message": "Pick a positive direction and stick to it."
  },
  "unit-conversion": {
   "meaning": "Wrong or missing unit conversion",
   "message": "Convert to SI units before calculating."
  },
  "forgot-square": {
   "meaning": "Missed a square",
   "message": "Check the power: v², ω², r²."
  },
  "wrong-power": {
   "meaning": "Wrong power (other than a missed square)",
   "message": "Check how the quantity scales."
  },
  "inverted": {
   "meaning": "Ratio or formula upside down",
   "message": "Check which goes on top."
  },
  "sin-cos-swap": {
   "meaning": "Swapped sin and cos",
   "message": "Adjacent → cos, opposite → sin."
  },
  "radius-diameter": {
   "meaning": "Used diameter for radius",
   "message": "r is the radius."
  },
  "forgot-g": {
   "meaning": "Used mass instead of weight, or dropped g",
   "message": "Weight = mg."
  },
  "forgot-mass": {
   "meaning": "Dropped or used the wrong mass",
   "message": "Which mass is moving?"
  },
  "forgot-half": {
   "meaning": "Dropped a ½ (KE, area of a triangle)",
   "message": "Check the ½."
  },
  "area-shape": {
   "meaning": "Wrong area under a graph",
   "message": "Split the area into simple shapes."
  },
  "stopped-early": {
   "meaning": "Gave a middle step as the answer",
   "message": "That's a middle step. Carry on to what's asked."
  },
  "wrong-quantity": {
   "meaning": "Found a different quantity than asked",
   "message": "Reread what the question asks for."
  },
  "ignored-condition": {
   "meaning": "Missed a condition (smooth, at rest, equal mass)",
   "message": "Underline the conditions in the question."
  },
  "missed-true-statement": {
   "meaning": "Rejected a true statement in a grid",
   "message": "Check each statement separately."
  },
  "recall-gap": {
   "meaning": "Didn't know a fact (L1 only)",
   "message": "This one needs learning. It will come back soon."
  },
  "slope-area-swap": {
   "meaning": "Confused gradient and area of a graph",
   "message": "Gradient = rate. Area = accumulation."
  },
  "boundary": {
   "meaning": "Wrong about whether limits are included",
   "message": "Check the end values of the range."
  },
  "v-zero-at-top": {
   "meaning": "Thinks the whole velocity is 0 at max height",
   "message": "Only the vertical part is zero at the top."
  },
  "accel-zero-at-top": {
   "meaning": "Thinks a = 0 when v = 0",
   "message": "Gravity never switches off: a = g the whole time."
  },
  "force-along-motion": {
   "meaning": "Thinks motion needs a forward force",
   "message": "Motion doesn't need a forward force."
  },
  "motion-vs-accel": {
   "meaning": "Confuses direction of motion with direction of acceleration",
   "message": "Acceleration follows the change in velocity, not the motion."
  },
  "up-down-time": {
   "meaning": "Thinks up and down times differ, without air resistance",
   "message": "Without air resistance, up and down times match."
  },
  "mean-of-speeds": {
   "meaning": "Averages speeds over unequal times",
   "message": "Use total displacement ÷ total time."
  },
  "pair-cancels": {
   "meaning": "Thinks third-law pairs cancel",
   "message": "Action and reaction act on different bodies."
  },
  "balance-vs-pair": {
   "meaning": "Confuses balanced forces with a third-law pair",
   "message": "A pair acts between the same two bodies."
  },
  "force-on-wrong-body": {
   "meaning": "Picks the force acting on the other body",
   "message": "Ask: which force acts on this body?"
  },
  "internal-force": {
   "meaning": "Thinks an internal force accelerates the system",
   "message": "Only external forces change the motion."
  },
  "friction-direction": {
   "meaning": "Has friction acting the wrong way",
   "message": "Friction opposes the sliding that would happen."
  },
  "normal-vertical": {
   "meaning": "Draws the normal reaction as always vertical",
   "message": "N is perpendicular to the surface."
  },
  "forgot-mu": {
   "meaning": "Used the full weight as the friction force",
   "message": "Friction depends on μ. Include it."
  },
  "centrifugal": {
   "meaning": "Adds an outward force in circular motion",
   "message": "Circular motion needs a net inward force."
  },
  "ke-conserved-inelastic": {
   "meaning": "Conserves KE in an inelastic collision or explosion",
   "message": "Momentum is conserved; KE is not."
  },
  "momentum-external-force": {
   "meaning": "Conserves momentum while an external force acts",
   "message": "An external force acts, so momentum changes."
  },
  "mass-matters": {
   "meaning": "Keeps mass where it cancels",
   "message": "Check if mass cancels out."
  },
  "linear-vs-angular": {
   "meaning": "Mixes linear and angular quantities",
   "message": "Rotating? Use the angular version."
  },
  "ke-conserved-rotation": {
   "meaning": "Conserves KE when I changes",
   "message": "Angular momentum is conserved here, not KE."
  },
  "moi-depends-on-omega": {
   "meaning": "Thinks I depends on spin rate",
   "message": "I depends on where the mass is, not on the speed."
  },
  "moi-shape-swap": {
   "meaning": "Swaps which shape has the larger I",
   "message": "More mass far from the axis gives a larger I."
  },
  "moi-mass-only": {
   "meaning": "Thinks equal mass means equal I",
   "message": "Where the mass sits matters too."
  },
  "moi-axis-free": {
   "meaning": "Thinks I doesn't depend on the axis",
   "message": "I depends on the axis."
  },
  "pair-unequal": {
   "meaning": "Thinks the forces of a pair differ in size",
   "message": "The two forces of a pair are always equal."
  },
  "pair-delay": {
   "meaning": "Thinks the reaction comes after the action",
   "message": "The two forces exist at the same time."
  },
  "pair-contact-only": {
   "meaning": "Thinks pairs need contact",
   "message": "Gravity forms pairs without contact."
  },
  "pair-wrong-bodies": {
   "meaning": "Picks a force between other bodies",
   "message": "A pair involves the same two bodies."
  },
  "free-fall-reading": {
   "meaning": "Expects a zero reading without free fall",
