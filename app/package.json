{
  "name": "unikey-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/noto-sans-sinhala": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "start": "npm run content && expo start",
    "android": "npm run content && expo start --android",
    "web": "npm run content && expo start --web",
    "merge-review": "node scripts/merge-review.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "maestro test --test-output-dir .maestro/output .maestro",
    "test:e2e:smoke": "maestro test --include-tags smoke --test-output-dir .maestro/output .maestro"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.engine-resolver.cjs",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
